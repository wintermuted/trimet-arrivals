{
  "name": "trimet-arrivals",
  "private": true,
  "workspaces": [
    "packages/*/*"
  ],
  "nx": {
    "implicitDependencies": [
      "@trimet-arrivals/app"
    ]
  },
  "author": "Jameson Nyeholt <jameson.nyeholt@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "places:refresh": "node scripts/refresh-places.mjs",
    "test:places-data": "node --test scripts/refresh-places.test.mjs",
    "watch": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ui": "jest --selectProjects ui --runInBand",
    "test:unit": "jest --selectProjects unit --runInBand",
    "test:coverage": "jest --coverage",
    "test:coverage-report": "node --test scripts/report-coverage.test.mjs",
    "coverage:report": "node scripts/report-coverage.mjs",
    "codecov": "codecov",
    "prettier": "prettier --check \"packages/applications/app/src/**/*.ts*\"",
    "prettier:fix": "prettier --write \"packages/applications/app/src/**/*.ts*\"",
    "tslint": "tslint \"packages/applications/app/src/**/*.ts*\"",
    "tslint:fix": "tslint --fix \"packages/applications/app/src/**/*.ts*\"",
    "semantic-release": "semantic-release",
    "trimet": "node ./scripts/split_routes.js"
  },
  "overrides": {
    "conventional-commits-parser@7.1.4": {
      "argue-cli": "3.2.0"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "tslint --fix",
      "git add"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/jest": "26.0.21",
    "@types/node": "24.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.22",
    "babel-jest": "27.5.1",
    "codecov": "^3.8.3",
    "husky": "^4.0.6",
    "identity-obj-proxy": "3.0.0",
    "jest": "27.5.1",
    "jest-environment-jsdom": "27.5.1",
    "lint-staged": "^16.2.6",
    "nvm": "^0.0.4",
    "nx": "24.0.6",
    "postcss": "^8.5.6",
    "prettier": "3.10.0",
    "sass": "^1.94.0",
    "ts-node": "^10.9.2",
    "tslint": "^5.20.1",
    "tslint-config-prettier": "^1.18.0",
    "tslint-react": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.19"
  }
}
