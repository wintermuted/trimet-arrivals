{
  "name": "overworld",
  "private": true,
  "workspaces": [
    "packages/*/*"
  ],
  "nx": {
    "implicitDependencies": [
      "@overworld/go-by-transit"
    ]
  },
  "author": "Jameson Nyeholt <jameson.nyeholt@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "install:tarballs": "node scripts/bootstrap-ui.mjs",
    "test:bootstrap-ui": "node --test scripts/bootstrap-ui.test.mjs",
    "places:refresh": "node scripts/refresh-places.mjs",
    "test:places-data": "node --test scripts/refresh-places.test.mjs",
    "watch": "vite",
    "storybook": "npm run storybook --workspace @overworld/storybook --",
    "build:storybook": "npm run build:storybook --workspace @overworld/storybook --",
    "typecheck:storybook": "npm run typecheck:storybook --workspace @overworld/storybook",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest run --project ui --maxWorkers=1",
    "test:unit": "vitest run --project unit --maxWorkers=1",
    "test:coverage": "vitest run --coverage",
    "test:coverage-report": "node --test scripts/report-coverage.test.mjs",
    "test:hooks": "node --test scripts/check-staged.test.mjs",
    "coverage:report": "node scripts/report-coverage.mjs",
    "format": "oxfmt --check \"packages/applications/go-by-transit/src/**/*.ts*\"",
    "format:fix": "oxfmt --write \"packages/applications/go-by-transit/src/**/*.ts*\"",
    "lint": "oxlint packages",
    "lint:fix": "oxlint packages --fix",
    "semantic-release": "semantic-release",
    "trimet": "node ./scripts/split_routes.js"
  },
  "overrides": {
    "conventional-commits-parser@7.1.4": {
      "argue-cli": "3.2.0"
    }
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "^10.6.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "nx": "24.0.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.6",
    "sass": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "volta": {
    "node": "26.13.1"
  }
}
