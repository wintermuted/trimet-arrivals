{
  "name": "overworld",
  "private": true,
  "workspaces": [
    "packages/*/*"
  ],
  "nx": {
    "implicitDependencies": [
      "@overworld/go-by-transit"
    ]
  },
  "author": "Jameson Nyeholt <jameson.nyeholt@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "places:refresh": "node scripts/refresh-places.mjs",
    "test:places-data": "node --test scripts/refresh-places.test.mjs",
    "watch": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ui": "jest --selectProjects ui --runInBand",
    "test:unit": "jest --selectProjects unit --runInBand",
    "test:coverage": "jest --coverage",
    "test:coverage-report": "node --test scripts/report-coverage.test.mjs",
    "test:hooks": "node --test scripts/check-staged.test.mjs",
    "coverage:report": "node scripts/report-coverage.mjs",
    "codecov": "codecov",
    "format": "oxfmt --check \"packages/applications/go-by-transit/src/**/*.ts*\"",
    "format:fix": "oxfmt --write \"packages/applications/go-by-transit/src/**/*.ts*\"",
    "lint": "oxlint packages",
    "lint:fix": "oxlint packages --fix",
    "semantic-release": "semantic-release",
    "trimet": "node ./scripts/split_routes.js"
  },
  "overrides": {
    "conventional-commits-parser@7.1.4": {
      "argue-cli": "3.2.0"
    }
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.22",
    "babel-jest": "30.5.2",
    "codecov": "^3.8.3",
    "husky": "^9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "nvm": "^0.0.4",
    "nx": "24.0.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.6",
    "sass": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
