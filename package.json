{
  "name": "trimet-arrivals",
  "private": true,
  "workspaces": ["packages/*"],
  "nx": {
    "implicitDependencies": ["@trimet-arrivals/app"]
  },
  "author": "Jameson Nyeholt <jameson.nyeholt@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@trimet-arrivals/bookmarks": "0.0.0",
    "@trimet-arrivals/journeys": "0.0.0",
    "@trimet-arrivals/places": "0.0.0",
    "@trimet-arrivals/routing": "0.0.0",
    "@trimet-arrivals/trimet-client": "0.0.0",
    "@trimet-arrivals/ui": "0.0.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^21.2.4",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mapbox/togeojson": "^0.16.0",
    "@turf/circle": "^7.1.0",
    "@turf/distance": "^7.1.0",
    "@types/classnames": "2.2.9",
    "@types/enzyme": "^3.1.18",
    "@types/geolib": "^2.0.23",
    "@types/jasmine-enzyme": "^7.0.1",
    "@types/jasmine-matchers": "^0.2.35",
    "@types/jest": "26.0.21",
    "@types/lodash": "4.17.27",
    "@types/mapbox-gl": "^2.7.2",
    "@types/moment": "^2.13.0",
    "@types/node": "24.3.0",
    "@types/prop-types": "15.7.5",
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.7",
    "@types/redux": "^3.6.0",
    "@types/redux-thunk": "^2.1.0",
    "@types/superagent": "4.1.15",
    "@wintermuted/ui-theme": "0.21.5",
    "autoprefixer": "^10.4.22",
    "classnames": "2.3.1",
    "codecov": "^3.8.3",
    "enzyme": "3.11.0",
    "enzyme-matchers": "^7.1.2",
    "font-awesome": "^4.7.0",
    "geolib": "^3.0.3",
    "jest-enzyme": "^4.2.0",
    "lodash": "4.18.1",
    "mapbox-gl": "^3.8.0",
    "moment": "^2.29.2",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-fontawesome": "^1.7.1",
    "react-redux": "^9.2.0",
    "react-router": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "react-select": "^5.10.2",
    "react-test-renderer": "^18.0.2",
    "redux": "^5.0.1",
    "redux-saga": "^1.1.3",
    "redux-thunk": "^3.0.0",
    "reselect": "^4.0.0",
    "sass": "^1.94.0",
    "superagent": "^10.4.2",
    "tslint": "^5.20.1",
    "tslint-config-prettier": "^1.18.0",
    "tslint-react": "^4.1.0",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "places:refresh": "node scripts/refresh-places.mjs",
    "test:places-data": "node --test scripts/refresh-places.test.mjs",
    "watch": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ui": "jest --selectProjects ui --runInBand",
    "test:coverage": "jest --coverage",
    "codecov": "codecov",
    "prettier": "prettier --check \"packages/app/src/**/*.ts*\"",
    "prettier:fix": "prettier --write \"packages/app/src/**/*.ts*\"",
    "tslint": "tslint \"packages/app/src/**/*.ts*\"",
    "tslint:fix": "tslint --fix \"packages/app/src/**/*.ts*\"",
    "semantic-release": "semantic-release",
    "trimet": "node ./scripts/split_routes.js"
  },
  "overrides": {
    "conventional-commits-parser@7.1.4": {
      "argue-cli": "3.2.0"
    },
    "enzyme": {
      "cheerio": "1.0.0-rc.12"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "tslint --fix",
      "git add"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@cfaester/enzyme-adapter-react-18": "0.8.0",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-jest": "27.5.1",
    "husky": "^4.0.6",
    "identity-obj-proxy": "3.0.0",
    "jest": "27.5.1",
    "jest-environment-jsdom": "27.5.1",
    "lint-staged": "^16.2.6",
    "nvm": "^0.0.4",
    "nx": "24.0.6",
    "prettier": "3.10.0",
    "ts-node": "^10.9.2",
    "vite": "^5.4.19"
  }
}
