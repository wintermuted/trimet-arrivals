{
  "name": "@overworld/ui-staging",
  "version": "0.0.0",
  "private": true,
  "description": "Context-free React components staged for later Wintermuted UI integration.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@wintermuted/ui-react": "^1.0.0",
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "nx": {
    "tags": [
      "domain:presentation",
      "type:library",
      "stage:generic"
    ],
    "targets": {
      "test:package": {
        "command": "vitest run --project ui-staging-package --maxWorkers=1",
        "cache": false
      },
      "typecheck": {
        "command": "tsc --noEmit -p packages/components/tsconfig.json"
      }
    }
  }
}
