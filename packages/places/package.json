{
  "name": "@trimet-arrivals/places",
  "version": "0.0.0",
  "private": true,
  "description": "Portland place discovery, saved places, and reference map layers.",
  "exports": {
    "./catalog": "./src/places.ts",
    "./contextOverlays": "./src/contextOverlays.ts",
    "./discovery": "./src/discovery.ts",
    "./lineOverlays": "./src/lineOverlays.ts",
    "./neighborhoods": "./src/neighborhoods.ts",
    "./savedPlaces": "./src/savedPlaces.ts"
  },
  "typesVersions": {
    "*": {
      "catalog": ["src/places.ts"],
      "contextOverlays": ["src/contextOverlays.ts"],
      "discovery": ["src/discovery.ts"],
      "lineOverlays": ["src/lineOverlays.ts"],
      "neighborhoods": ["src/neighborhoods.ts"],
      "savedPlaces": ["src/savedPlaces.ts"]
    }
  },
  "dependencies": {
    "@turf/distance": "^7.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "nx": {
    "targets": {
      "test:package": {
        "command": "jest --selectProjects places-package --runInBand",
        "cache": false
      }
    }
  }
}
