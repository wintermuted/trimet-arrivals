{
  "name": "@overworld/maps",
  "version": "0.0.0",
  "private": true,
  "description": "Mapbox lifecycle and transit, place, and planner overlays with injected providers.",
  "exports": {
    ".": "./src/index.ts",
    "./transit": "./src/transit.ts",
    "./places": "./src/places.ts",
    "./planner": "./src/planner.ts"
  },
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "transit": [
        "src/transit.ts"
      ],
      "places": [
        "src/places.ts"
      ],
      "planner": [
        "src/planner.ts"
      ]
    }
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@overworld/places": "0.0.0",
    "@overworld/routing": "0.0.0",
    "@overworld/trimet-client": "0.0.0",
    "@turf/circle": "^7.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@turf/distance": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  },
  "peerDependencies": {
    "mapbox-gl": "^3.8.0",
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "nx": {
    "tags": [
      "domain:geography",
      "type:library"
    ],
    "targets": {
      "test:package": {
        "command": "jest --selectProjects maps-package --runInBand",
        "cache": false
      }
    }
  }
}
