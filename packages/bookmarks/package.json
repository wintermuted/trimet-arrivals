{
  "name": "@trimet-arrivals/bookmarks",
  "version": "0.0.0",
  "private": true,
  "description": "Browser storage for stop and route bookmarks, sections, route groups, and shortcuts.",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts"
  },
  "types": "./src/index.ts",
  "typesVersions": {
    "*": { "react": ["src/react.ts"] }
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "dependencies": {
    "@trimet-arrivals/trimet-client": "0.0.0",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@types/lodash": "4.17.27"
  },
  "nx": {
    "targets": {
      "test:package": {
        "command": "jest --selectProjects bookmarks-package --runInBand",
        "cache": false
      }
    }
  }
}
