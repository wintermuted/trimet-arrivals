{
  "name": "@overworld/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive catalog of Overworld product presentation components.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "typecheck:storybook": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@overworld/trimet-client": "0.0.0",
    "@overworld/ui": "0.0.0",
    "@wintermuted/ui-react": "1.2.0",
    "@wintermuted/ui-theme": "1.0.3",
    "font-awesome": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "storybook": "10.6.7",
    "vite": "^8.3.8"
  },
  "nx": {
    "tags": ["domain:presentation", "type:application"],
    "targets": {
      "build:storybook": {
        "cache": false,
        "outputs": ["{projectRoot}/storybook-static"]
      }
    }
  }
}
