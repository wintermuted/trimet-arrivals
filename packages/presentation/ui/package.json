{
  "name": "@overworld/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React time, transit, journey, alert, vehicle, and search presentation with injected app policies.",
  "exports": {
    ".": "./src/index.ts",
    "./transit": "./src/transit.ts",
    "./journeys": "./src/journeys.ts",
    "./alerts": "./src/alerts.ts",
    "./vehicles": "./src/vehicles.ts",
    "./search": "./src/search.ts",
    "./disclosure": "./src/styles/_disclosure.scss"
  },
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "transit": [
        "src/transit.ts"
      ],
      "journeys": [
        "src/journeys.ts"
      ],
      "alerts": [
        "src/alerts.ts"
      ],
      "vehicles": [
        "src/vehicles.ts"
      ],
      "search": [
        "src/search.ts"
      ]
    }
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@overworld/trimet-client": "0.0.0",
    "@overworld/ui-staging": "0.0.0",
    "lodash": "4.18.1",
    "react-fontawesome": "^1.7.1"
  },
  "peerDependencies": {
    "@wintermuted/ui-react": "^1.0.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-select": "^5.10.2"
  },
  "nx": {
    "tags": [
      "domain:presentation",
      "type:library"
    ],
    "targets": {
      "test:package": {
        "command": "vitest run --project ui-package --maxWorkers=1",
        "cache": false
      }
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "4.17.27",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
